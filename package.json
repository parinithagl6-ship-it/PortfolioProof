{
  "name": "portfolio-proof",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm test -w backend && npm test -w frontend",
    "seed": "npm run seed -w backend",
    "add:smartspend": "npm run add:smartspend -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}